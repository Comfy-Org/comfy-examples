# One of:
# - local: http://127.0.0.1:8189 (comfy-api-proxy in front of local ComfyUI)
# - serverless: https://dep-123.run.comfy.app
COMFY_BASE_URL=
# Required for Comfy Cloud or Serverless. Optional for an unprotected local proxy.
# Generate this in platform.comfy.org. This value must never reach the browser.
COMFY_API_KEY=
