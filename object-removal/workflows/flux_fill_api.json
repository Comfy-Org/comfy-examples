{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "source.png" }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": { "image": "mask.png" }
  },
  "3": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": ["2", 1],
      "expand": 10,
      "tapered_corners": true
    }
  },
  "4": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "clip_l.safetensors",
      "clip_name2": "t5xxl_fp16.safetensors",
      "type": "flux",
      "device": "default"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "ae.safetensors" }
  },
  "6": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-fill-dev.safetensors",
      "weight_dtype": "default"
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["4", 0],
      "text": "Remove the masked object and reconstruct the surrounding background naturally."
    }
  },
  "8": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": ["7", 0],
      "guidance": 30
    }
  },
  "9": {
    "class_type": "ConditioningZeroOut",
    "inputs": { "conditioning": ["7", 0] }
  },
  "10": {
    "class_type": "DifferentialDiffusion",
    "inputs": {
      "model": ["6", 0],
      "strength": 1
    }
  },
  "11": {
    "class_type": "InpaintModelConditioning",
    "inputs": {
      "positive": ["8", 0],
      "negative": ["9", 0],
      "vae": ["5", 0],
      "pixels": ["1", 0],
      "mask": ["3", 0],
      "noise_mask": true
    }
  },
  "12": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1,
      "model": ["10", 0],
      "positive": ["11", 0],
      "negative": ["11", 1],
      "latent_image": ["11", 2]
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["12", 0],
      "vae": ["5", 0]
    }
  },
  "14": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["13", 0],
      "filename_prefix": "visual-correction"
    }
  }
}
